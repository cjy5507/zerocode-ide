diff --git a/exporters/tsv.py b/exporters/tsv.py
index 18d5103..96b9866 100644
--- a/exporters/tsv.py
+++ b/exporters/tsv.py
@@ -26,0 +27,35 @@
+from fractions import Fraction
+import re
+
+_ESCAPES = {"\\": "\\\\", "\t": "\\t", "\n": "\\n", "\r": "\\r"}
+_BACK = {written: char for char, written in _ESCAPES.items()}
+
+
+def _escape(text):
+    return "".join(_ESCAPES.get(char, char) for char in text)
+
+
+def _unescape(text):
+    def back(found):
+        if found[0] not in _BACK:
+            raise ValueError(f"not an escape: {found[0]!r}")
+        return _BACK[found[0]]
+
+    return re.sub(r"\\.?", back, text, flags=re.S)
+
+
+def _decimal(text, places):
+    whole = round(abs(Fraction(text)) * 10 ** places)
+    digits = str(whole).rjust(places + 1, "0")
+    written = f"{digits[:-places]}.{digits[-places:]}" if places else digits
+    return f"-{written}" if text.startswith("-") else written
+
+
+def _cell(cell, column):
+    if cell is None:
+        return "\\N"
+    if column.kind == "decimal":
+        return _decimal(cell, column.places)
+    return _escape(str(cell))
+
+
