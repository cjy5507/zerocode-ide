@@ -30,0 +31,31 @@ it has no known one.
+from fractions import Fraction
+
+FULL = "█"
+HALF = "▌"
+
+
+def _pick(report, column):
+    for index, one in enumerate(report.columns):
+        if column is None and one.kind != "text":
+            return index
+        if one.name == column:
+            if one.kind == "text":
+                raise ValueError(f"{column} is not numeric")
+            return index
+    raise ValueError(f"no column to draw: {column}")
+
+
+def _label(row, columns):
+    for cell, column in zip(row.cells, columns):
+        if column.kind == "text" and cell is not None:
+            return cell
+    return "?"
+
+
+def _bar(value, top, width):
+    if value <= 0 or top <= 0:
+        return ""
+    halves = max(1, int(value * width * 2 / top + Fraction(1, 2)))
+    return FULL * (halves // 2) + (HALF if halves % 2 else "")
+
+
