diff --git a/exporters/markdown.py b/exporters/markdown.py
index f709e43..92d54dd 100644
--- a/exporters/markdown.py
+++ b/exporters/markdown.py
@@ -33,0 +34,52 @@ Between blocks there is one blank line and the document ends with one newline.
+from fractions import Fraction
+
+
+def _decimal(exact, places):
+    whole = int(abs(exact) * 10 ** places + Fraction(1, 2))
+    digits = str(whole).rjust(places + 1, "0")
+    text = f"{digits[:-places]}.{digits[-places:]}" if places else digits
+    return f"-{text}" if exact < 0 and whole else text
+
+
+def _text(value):
+    return value.replace("|", "\\|").replace("\n", "<br>")
+
+
+def _cell(value, column):
+    if value is None:
+        return ""
+    if column.kind == "decimal":
+        return _decimal(Fraction(value), column.places)
+    return _text(value) if column.kind == "text" else str(value)
+
+
+def _totals(section, columns):
+    """The written sum of each numeric column by index."""
+    totals = {}
+    for index, column in enumerate(columns):
+        if column.kind != "text":
+            known = [row.cells[index] for row in section.rows if row.cells[index] is not None]
+            if column.kind == "decimal":
+                totals[index] = _decimal(sum((Fraction(cell) for cell in known), Fraction(0)), column.places)
+            else:
+                totals[index] = str(sum(known))
+    return totals
+
+
+def _table(section, columns):
+    head = [_text(column.name) for column in columns]
+    rows = [[_cell(cell, column) for cell, column in zip(row.cells, columns)] for row in section.rows]
+    totals = _totals(section, columns)
+    widths = [max(3, len(head[i]), len(totals.get(i, "")), *(len(row[i]) for row in rows)) for i in range(len(columns))]
+
+    def padded(cells):
+        out = [cell.ljust(widths[i]) if columns[i].kind == "text" else cell.rjust(widths[i]) for i, cell in enumerate(cells)]
+        return "| " + " | ".join(out) + " |"
+
+    rule = [":" + "-" * (widths[i] + 1) if columns[i].kind == "text" else "-" * (widths[i] + 1) + ":" for i in range(len(columns))]
+    closing = [totals.get(i, "") for i in range(len(columns))]
+    if columns[0].kind == "text":
+        closing[0] = "**total**"
+    return [padded(head), "|" + "|".join(rule) + "|"] + [padded(row) for row in rows] + ["| " + " | ".join(closing) + " |"]
+
+
