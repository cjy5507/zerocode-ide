diff --git a/runner.py b/runner.py
index 7dcc5f6..c985d22 100644
--- a/runner.py
+++ b/runner.py
@@ -33,7 +33,11 @@ def run_until_idle(store, handler, effects, checkpoint_every=0):
-        try:
-            result = handler(payload)
-        except JobError:
-            store.fail(job)
-            continue
-        effects.apply(job, result)
-        store.complete(job, result)
+        done = dict(effects.applied())
+        if job in done:
+            store.complete(job, done[job])
+        else:
+            try:
+                result = handler(payload)
+            except JobError:
+                store.fail(job)
+                continue
+            effects.apply(job, result)
+            store.complete(job, result)
