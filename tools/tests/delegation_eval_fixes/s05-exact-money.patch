+def _share_discount(lines, percent):
+    subtotal = sum(line.gross for line in lines)
+    if not subtotal:
+        return
+    discount = round_half_up(subtotal * percent / 100)
+    sign = -1 if discount < 0 else 1
+    exact = [abs(Fraction(line.gross * discount, subtotal)) for line in lines]
+    shares = [int(share) for share in exact]
+    left = abs(discount) - sum(shares)
+    by_fraction = sorted(range(len(lines)), key=lambda i: (shares[i] - exact[i], i))
+    for index in by_fraction[:left]:
+        shares[index] += 1
+    for line, share in zip(lines, shares):
+        line.discount = sign * share
