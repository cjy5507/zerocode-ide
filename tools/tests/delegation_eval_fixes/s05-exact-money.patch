-        tax_by_class[tax_class] = round2(tax_by_class.get(tax_class, 0) + tax.tax_on(line.net, tax_class))
+    for sku, qty in items:
+        unit = catalog.price(sku, currency, prices)
+        lines.append(Line(sku, qty, unit, unit * qty))
+    _share_discount(lines, Fraction(order.get("discount_percent", "0")))
+    net_by_class = {}
+    for line in lines:
+        tax_class = tax.class_of(line.sku)
+        net_by_class[tax_class] = net_by_class.get(tax_class, 0) + line.net
+    tax_by_class = {name: tax.tax_on(net, name) for name, net in net_by_class.items()}
