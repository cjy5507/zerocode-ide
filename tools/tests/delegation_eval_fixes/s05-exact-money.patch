+    items = order["items"]
+    if any(qty > 0 for _, qty in items) and any(qty < 0 for _, qty in items):
+        raise ValueError("an invoice holds ordinary lines or credit lines, not both")
+    prices = order.get("prices", catalog.PRICES)
@@ -42,8 +66,9 @@ def build_invoice(order):
