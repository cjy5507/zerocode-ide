diff --git a/money.py b/money.py
index 86abaf6..a697586 100644
--- a/money.py
+++ b/money.py
@@ -2,0 +3 @@
+from fractions import Fraction
@@ -4,2 +5 @@
-def round2(amount):
-    return round(amount, 2)
+PLACES = {"USD": 2, "JPY": 0, "KWD": 3}
@@ -8,2 +8,25 @@ def round2(amount):
-def fmt(amount):
-    return f"{amount:.2f}"
+def places(currency):
+    if currency not in PLACES:
+        raise ValueError(f"unknown currency: {currency}")
+    return PLACES[currency]
+
+
+def parse(text, currency):
+    """The whole smallest units TEXT writes in CURRENCY."""
+    minor = Fraction(text) * 10 ** places(currency)
+    if minor.denominator != 1:
+        raise ValueError(f"{text} is finer than {currency} allows")
+    return int(minor)
+
+
+def round_half_up(exact):
+    """EXACT to a whole number, a half going away from zero."""
+    size = int(abs(exact) + Fraction(1, 2))
+    return -size if exact < 0 else size
+
+
+def fmt(amount, currency):
+    digits = places(currency)
+    sign = "-" if amount < 0 else ""
+    whole, part = divmod(abs(amount), 10 ** digits)
+    return f"{sign}{whole}.{part:0{digits}d}" if digits else f"{sign}{whole}"
