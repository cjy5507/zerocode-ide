@@ -39,0 +89,19 @@ def _match(pattern, text):
+
+
+def _in_set(body, char):
+    negated = body.startswith("!")
+    if negated:
+        body = body[1:]
+    found, index = False, 0
+    while index < len(body):
+        low = body[index]
+        if low == "\\" and index + 1 < len(body):
+            index += 1
+            low = body[index]
+        if index + 2 < len(body) and body[index + 1] == "-":
+            found = found or low <= char <= body[index + 2]
+            index += 3
+        else:
