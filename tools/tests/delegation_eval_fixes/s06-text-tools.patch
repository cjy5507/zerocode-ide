+
+
+def _set_end(pattern, start):
+    """The index of the `]` closing the `[` at START, or START itself when none does."""
+    index = start + 1
+    if index < len(pattern) and pattern[index] == "!":
+        index += 1
+    if index < len(pattern) and pattern[index] == "]":
+        index += 1
+    while index < len(pattern):
+        if pattern[index] == "\\":
+            index += 1
+        elif pattern[index] == "]":
+            return index
+        index += 1
+    return start
+
+
+def _split_segments(pattern):
+    """PATTERN cut at the slashes that are its own, not those escaped or inside a set."""
+    segments, start, index = [], 0, 0
+    while index < len(pattern):
+        char = pattern[index]
+        if char == "\\":
+            index += 1
+        elif char == "[":
+            index = _set_end(pattern, index)
+        elif char == "/":
+            segments.append(pattern[start:index])
+            start = index + 1
+        index += 1
+    segments.append(pattern[start:])
+    return segments
+
+
+@lru_cache(maxsize=None)
+def _segments(pattern, path):
+    if not pattern:
+        return not path
+    if pattern[0] == "**":
+        return any(_segments(pattern[1:], path[skip:]) for skip in range(len(path) + 1)) or (path == ("",) and len(pattern) == 1)
+    return bool(path) and _match(pattern[0], path[0]) and _segments(pattern[1:], path[1:])
