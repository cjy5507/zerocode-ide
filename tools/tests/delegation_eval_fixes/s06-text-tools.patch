@@ -30,0 +34,28 @@ class Cycle(ValueError):
+def _whole(graph):
+    """GRAPH with every node present and each dependency once."""
+    whole = {node: set(deps) for node, deps in graph.items()}
+    for deps in graph.values():
+        for dep in deps:
+            whole.setdefault(dep, set())
+    return whole
+
+
+def _shortest_cycle(whole):
+    best = None
+    for start in sorted(whole):
+        paths = [[start]]
+        seen = {start}
+        while paths and best is None or (paths and len(paths[0]) < len(best)):
+            next_paths = []
+            for path in paths:
+                for dep in sorted(whole[path[-1]]):
+                    if dep == start:
+                        if best is None or (len(path), path) < (len(best), best):
+                            best = path
+                    elif dep > start and dep not in seen:
+                        seen.add(dep)
+                        next_paths.append(path + [dep])
+            paths = next_paths
+    return best
+
+
