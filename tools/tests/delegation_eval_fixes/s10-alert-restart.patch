diff --git a/outbox.py b/outbox.py
index f125f69..f603a93 100644
--- a/outbox.py
+++ b/outbox.py
@@ -2,0 +3,2 @@
+LONGEST_DELAY = 16
+
@@ -9,2 +11,2 @@ class Outbox:
-    def __init__(self):
-        self.messages = []
+    def __init__(self, entries=None):
+        self.entries = entries if entries is not None else []
@@ -13 +15 @@ class Outbox:
-        self.messages.append(message)
+        self.entries.append({"message": message, "failures": 0, "next_try": None})
@@ -15,3 +17,10 @@ class Outbox:
-    def deliver(self, transport):
-        """Send everything waiting; what fails stays for next time."""
-        for message in list(self.messages):
+    def deliver(self, now, transport, changed):
+        """Send what is due, oldest first, calling CHANGED after each outcome."""
+        held_back = set()
+        for entry in list(self.entries):
+            rule = entry["message"]["rule"]
+            if rule in held_back:
+                continue
+            if entry["next_try"] is not None and now < entry["next_try"]:
+                held_back.add(rule)
+                continue
@@ -19 +28 @@ class Outbox:
-                transport.send(message)
+                transport.send(entry["message"])
@@ -21,2 +30,6 @@ class Outbox:
-                continue
-            self.messages.remove(message)
+                entry["failures"] += 1
+                entry["next_try"] = now + min(2 ** (entry["failures"] - 1), LONGEST_DELAY)
+                held_back.add(rule)
+            else:
+                self.entries.remove(entry)
+            changed()
