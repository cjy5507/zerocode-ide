# Reverse-engineering scratch. Never commit: it holds third-party bytes
# extracted from a locally installed application.
.re-scratch/

target/
# The verification batteries' shared build cache — see WORKBOARD memo 54.
target-verify/
# No trailing slash: a directory rule does not match the node_modules SYMLINK the
# window shares into every worktree, and `git add -A` there once committed it (249f699).
node_modules
ui/node_modules/
ui/dist/
.DS_Store

# Local runtime state. Hosting a lane in this checkout makes `zo` write here,
# and `settings.local.json` is per-machine by definition.
.zo/

# tauri-build regenerates these permission schemas from the installed Tauri
# version on every build, so committing them only produces churn.
crates/zerocode-shell/gen/

# Local tool droppings — an IDE's project dir and the artifacts the browser
# harnesses leave behind. Twice now a stray `git add -A` swept all four into
# the index; ignoring them is what makes that sweep impossible.
.idea/
.playwright-cli/
.playwright-mcp/
output/

# The updater's private key lives under ~/.local/share/zerocode/release/keys on
# the lane machine only (tools/release/README.md); the contract
# no_private_key_in_the_tree reads the tree for one as well.
*.key

# tools/release/tests leaves these behind when run as a module.
__pycache__/

# The zo binary staged for the release bundle (t-3191, scripts/stage-zo.mjs):
# built or copied right before `tauri build`, never committed.
crates/zerocode-shell/bin/

# Design notes, measurements, captures and benches. They carry this machine's
# paths, the accounts signed in on it, and the names of company systems the
# work was measured against — a published repository is the wrong place for
# any of it, and no build or test reads them. The files stay on disk; git
# simply stops carrying them.
docs/

# Working notes and agent instructions: meeting jottings, the PRD draft, and
# the orchestration briefings this machine runs on. They are notes about the
# work, not the work; a published repository carries the source and its README.
/PRD.md
/AGENTS.md
/CLAUDE.md
/untitled.md
/untitled-2.md
