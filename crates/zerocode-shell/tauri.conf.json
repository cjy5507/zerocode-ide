{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroCode",
  "version": "1.1.15",
  "identifier": "dev.zerocode.app",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ZeroCode",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/cjy5507/zerocode/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MkI2QUZGQUNENDlFRTMKUldUam50U3MvMm9yVjJNcEsyREJzVzJvYUZEa21Bd2FQUmVmd29vVG1wZGFMbGduOTNWbkFzYncK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "resources": [
      "native/ios-emulator-helper/LICENSE-APACHE-2.0",
      "native/ios-emulator-helper/LICENSE-IDB-MIT",
      "native/ios-emulator-helper/NOTICE.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
