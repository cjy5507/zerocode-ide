      "color": "var(--app-primary-foreground)",
      "display": "flex",
      "padding": "var(--message-padding-top)0 8px",
      "position": "relative",
      "flex-direction": "column",
      "align-items": "flex-start",
      "gap": "0"
    },
    "timelineMessage": {
      "user-select": "text",
      "align-items": "flex-start",
      "padding-left": "30px"
    },
    "timelineMessage:before": {
      "content": "\"\"",
      "position": "absolute",
      "left": "9px",
      "top": "calc(var(--message-padding-top,8px) + 7px)",
      "background-color": "var(--app-secondary-foreground)",
      "z-index": "1",
      "border-radius": "50%",
      "width": "7px",
      "height": "7px"
    },
    "timelineMessage:after": {
      "content": "\"\"",
      "position": "absolute",
      "background-color": "var(--app-primary-border-color)",
      "width": "1px",
      "top": "0",
      "bottom": "0",
      "left": "12px"
    },
    "timelineMessage.dotSuccess:before": {
      "background-color": "#74c991"
    },
    "timelineMessage.dotFailure:before": {
      "background-color": "#c74e39"
    },
